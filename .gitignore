# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Environment files — never commit secrets. The .env.example files
# in backend/ and frontend/ are the committed templates.
.env
**/.env
backend/.env.backup
backend/.env.production
frontend/.env.local
frontend/.env.*.local

# Dependencies (covered by sub-gitignores too, repeated here as defense in depth)
node_modules/
**/node_modules/
vendor/
**/vendor/

# Build outputs
dist/
build/
